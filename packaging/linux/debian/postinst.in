#!/bin/sh
set -eu

case "${1:-}" in
    configure|abort-upgrade|abort-remove|abort-deconfigure)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper enable sunlens-recover.service >/dev/null
        fi
        "@CMAKE_INSTALL_FULL_LIBEXECDIR@/sunlens/sunlens-tunnel-helper" --finish-install
        ;;
esac
