[Unit]
Description=Восстановление незавершённых сетевых транзакций SUNLENS
After=local-fs.target
Before=network-pre.target
ConditionPathExists=/var/lib/sunlens/recovery.json

[Service]
Type=oneshot
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/sunlens/sunlens-tunnel-helper --recover
User=root
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
RuntimeDirectory=sunlens
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/sunlens /run/sunlens

[Install]
WantedBy=multi-user.target
