if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
    message(FATAL_ERROR "DEB предназначен только для Linux x86_64")
endif()
if(NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr" OR NOT Qt6_VERSION MATCHES "^6\\.4\\.")
    message(FATAL_ERROR "DEB требует /usr и системную Qt 6.4 Ubuntu 24.04")
endif()
if(IS_ABSOLUTE "${CMAKE_INSTALL_LIBEXECDIR}" OR NOT CMAKE_INSTALL_LIBEXECDIR STREQUAL "libexec")
    message(FATAL_ERROR "DEB требует стандартный /usr/libexec для помощника")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/package-cores.cmake")

configure_file(packaging/linux/debian/prerm.in "${CMAKE_CURRENT_BINARY_DIR}/debian/prerm" @ONLY)
configure_file(packaging/linux/debian/postinst.in "${CMAKE_CURRENT_BINARY_DIR}/debian/postinst" @ONLY)

set(CPACK_GENERATOR DEB)
set(CPACK_PACKAGE_NAME sunlens)
set(CPACK_PACKAGE_VENDOR SUNLENS)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "SUNLENS — настольный VPN-клиент, сборка для проверки")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_CONTACT "SUNLENS")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
set(CPACK_DEBIAN_PACKAGE_SECTION net)
set(CPACK_DEBIAN_PACKAGE_PRIORITY optional)
set(CPACK_DEBIAN_FILE_NAME "sunlens-${PROJECT_VERSION}-linux-amd64.deb")
# Нативный Qt из noble; QML imports и плагины не видны анализатору ELF.
set(CPACK_DEBIAN_PACKAGE_DEPENDS
    "libc6 (>= 2.38), libstdc++6 (>= 13), libgcc-s1, libqt6core6t64 (>= 6.4.2), libqt6gui6t64, libqt6network6t64, libqt6quick6, libqt6quickcontrols2-6, libqt6concurrent6t64, libqt6sql6t64, libqt6sql6-sqlite, libqt6svg6, qt6-qpa-plugins, qml6-module-qtqml, qml6-module-qtqml-models, qml6-module-qtqml-workerscript, qml6-module-qtquick, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-templates, qml6-module-qtquick-window, iproute2, pkexec, polkitd, systemd-resolved, ca-certificates")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "qt6-wayland, fonts-dejavu-core")
set(CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA
    "${CMAKE_CURRENT_BINARY_DIR}/debian/prerm;${CMAKE_CURRENT_BINARY_DIR}/debian/postinst;${CMAKE_CURRENT_SOURCE_DIR}/packaging/linux/debian/postrm")
set(CPACK_DEBIAN_PACKAGE_CONTROL_STRICT_PERMISSION TRUE)
set(CPACK_STRIP_FILES OFF)
set(CPACK_DEBIAN_COMPRESSION_TYPE zstd)
set(CPACK_VERBATIM_VARIABLES ON)
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE")
include(CPack)
