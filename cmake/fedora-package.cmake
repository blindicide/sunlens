if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$"
    OR NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr" OR NOT CMAKE_INSTALL_LIBEXECDIR STREQUAL "libexec")
    message(FATAL_ERROR "RPM требует нативный Linux x86_64 с префиксом /usr и libexec")
endif()
file(STRINGS "/etc/os-release" FEDORA_ID REGEX "^ID=fedora$")
file(STRINGS "/etc/os-release" FEDORA_RELEASE REGEX "^VERSION_ID=\"?44\"?$")
if(NOT FEDORA_ID OR NOT FEDORA_RELEASE OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "RPM собирается только на нативной Fedora 44")
endif()
find_program(RPMBUILD_EXECUTABLE rpmbuild REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/package-cores.cmake")

foreach(script IN ITEMS preinstall postinstall preremove postremove)
    configure_file("packaging/linux/rpm/${script}.in"
        "${CMAKE_CURRENT_BINARY_DIR}/rpm/${script}" @ONLY)
endforeach()
set(CPACK_GENERATOR RPM)
set(CPACK_PACKAGE_NAME sunlens)
set(CPACK_PACKAGE_VENDOR SUNLENS)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "SUNLENS — настольный VPN-клиент, сборка для проверки")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_RPM_PACKAGE_NAME sunlens)
set(CPACK_RPM_PACKAGE_ARCHITECTURE x86_64)
set(CPACK_RPM_PACKAGE_RELEASE "1")
set(CPACK_RPM_PACKAGE_LICENSE "LicenseRef-Not-Approved-For-Distribution")
set(CPACK_RPM_FILE_NAME "sunlens-${PROJECT_VERSION}-linux-x86_64.rpm")
set(CPACK_RPM_PACKAGE_REQUIRES
    "qt6-qtbase-gui, qt6-qtdeclarative, qt6-qtsvg, iproute, polkit, systemd-resolved, ca-certificates")
set(CPACK_RPM_PACKAGE_REQUIRES_POST "systemd")
set(CPACK_RPM_PACKAGE_REQUIRES_PREUN "systemd")
set(CPACK_RPM_PACKAGE_REQUIRES_POSTUN "systemd")
set(CPACK_RPM_PRE_INSTALL_SCRIPT_FILE "${CMAKE_CURRENT_BINARY_DIR}/rpm/preinstall")
set(CPACK_RPM_POST_INSTALL_SCRIPT_FILE "${CMAKE_CURRENT_BINARY_DIR}/rpm/postinstall")
set(CPACK_RPM_PRE_UNINSTALL_SCRIPT_FILE "${CMAKE_CURRENT_BINARY_DIR}/rpm/preremove")
set(CPACK_RPM_POST_UNINSTALL_SCRIPT_FILE "${CMAKE_CURRENT_BINARY_DIR}/rpm/postremove")
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION
    "/usr/libexec;/usr/lib/systemd;/usr/lib/systemd/system;/usr/share/applications;/usr/share/icons;/usr/share/icons/hicolor;/usr/share/icons/hicolor/scalable;/usr/share/icons/hicolor/scalable/apps;/usr/share/polkit-1;/usr/share/polkit-1/actions")
# Ядра должны остаться побайтно идентичными manifest; BRP strip меняет ELF.
set(CPACK_RPM_SPEC_MORE_DEFINE "%define __os_install_post %{nil}\n%define _build_id_links none")
set(CPACK_RPM_DEBUGINFO_PACKAGE OFF)
set(CPACK_STRIP_FILES OFF)
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
